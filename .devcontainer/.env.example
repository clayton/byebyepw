# Copy to .devcontainer/.env to customize defaults, or pass inline env vars.

# Supported official PHP Apache versions: 8.0, 8.2, 8.4, 8.6 (or any php:<ver>-apache tag)
PHP_VERSION=8.6

# WordPress version: 7.2-RC3, rc/beta (resolves latest RC/beta), nightly, latest/stable, or exact version (e.g. 7.1.5)
WP_VERSION=7.2-RC3

# Host ports (mapped to container :80 and :8443)
HTTP_PORT=8080
HTTPS_PORT=8443

# Primary site host (both byebyepw.test and localhost are in the TLS cert SANs and accepted by wp-config.php)
WP_SITE_HOST=byebyepw.test
WP_SITE_URL=https://byebyepw.test:8443

# Test user credentials (local dev only)
WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin123!
WP_ADMIN_EMAIL=admin@byebyepw.test
WP_SUBSCRIBER_USER=subscriber
WP_SUBSCRIBER_PASS=subscriber123!
WP_SUBSCRIBER_EMAIL=subscriber@byebyepw.test

# Database credentials (local dev only)
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpass
